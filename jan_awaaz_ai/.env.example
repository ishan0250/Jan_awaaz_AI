# Copy this file to .env and fill in your real values. Never commit the real .env.
GEMINI_API_KEY=your_gemini_api_key_here

# --- WhatsApp channel (only needed for the LIVE webhook demo, see README) ---
# The plain click-to-chat link (wa.me) works with none of these set.
# Get these free from a Meta developer test number — no business
# verification needed for testing with up to 5 approved recipient numbers.
WHATSAPP_ACCESS_TOKEN=your_temporary_meta_access_token
WHATSAPP_PHONE_NUMBER_ID=your_test_phone_number_id
WHATSAPP_VERIFY_TOKEN=jan_awaaz_verify
